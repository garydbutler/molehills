# Copy this file to .env.local for local development.
# On Vercel these come from the project's database integration.

# Vercel Postgres / Neon connection string. After linking a database in the
# Vercel dashboard, run `vercel env pull .env.local` to fetch the real value.
POSTGRES_URL=postgresql://user:password@host/dbname
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
