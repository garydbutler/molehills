# Molehill Web Environment Variables

# Database (Vercel Postgres / Neon)
POSTGRES_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=

# AI Vision (Google Gemini Developer API)
# Required for /api/plan and /api/end-state routes.
# Get your key at https://aistudio.google.com/apikey
# IMPORTANT: Production must use paid tier to avoid data logging.
GEMINI_API_KEY=

# ----- OAuth / Auth.js -----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Production: https://molehills.vercel.app  |  Local: http://localhost:3000
AUTH_URL=

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login (from developers.facebook.com)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
