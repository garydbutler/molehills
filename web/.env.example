# Molehill Web Environment Variables

# Database (Vercel Postgres / Neon)
POSTGRES_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=

# AI Vision (Google Gemini Developer API)
# Required for /api/plan and /api/end-state routes.
# Get your key at https://aistudio.google.com/apikey
# IMPORTANT: Production must use paid tier to avoid data logging.
GEMINI_API_KEY=
