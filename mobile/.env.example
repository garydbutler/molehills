# Molehill Mobile Environment Variables

# API URL for the Next.js backend
# In development, use your local Next.js server or a tunnel
# In production, use your Vercel deployment URL
EXPO_PUBLIC_API_URL=https://molehills.vercel.app

# Note: OAuth client IDs and secrets are server-side only (web/.env).
# The mobile app initiates OAuth via the API and receives a signed JWT back.
# No client secrets should ever be placed in this file.

# RevenueCat publishable SDK keys (safe in the bundle; not the secret key).
# Test Store key works on both platforms until the real store apps are configured.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
