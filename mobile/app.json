{
  "expo": {
    "name": "unbig",
    "slug": "molehill",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/unbig-mountain-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "molehill",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.inchmeal.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.inchmeal",
      "adaptiveIcon": {
        "backgroundColor": "#faf7f2",
        "foregroundImage": "./assets/unbig-mountain-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/unbig-mountain-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow unbig to access your photos so you can show it where a project stands.",
          "cameraPermission": "Allow unbig to use the camera so you can photograph a project before and after."
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f3f0"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27d99236-fe20-4e75-b56e-3fcc6e8eafec"
      }
    },
    "owner": "garydbutler"
  }
}
