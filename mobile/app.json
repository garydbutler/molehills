{
  "expo": {
    "name": "Squirrelz",
    "slug": "molehill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "molehill",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.molehills.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.molehills",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Molehill to access your photos so you can capture the spaces you want to transform.",
          "cameraPermission": "Allow Molehill to use the camera so you can photograph the spaces you want to transform."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27d99236-fe20-4e75-b56e-3fcc6e8eafec"
      }
    },
    "owner": "garydbutler"
  }
}
